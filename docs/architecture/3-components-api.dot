digraph G {
  graph [fontname="Arial", rankdir=TB, nodesep=0.55, ranksep=0.85, pad=0.3, newrank=true, nodesep=0.35, ranksep=0.75];
  node [fontname="Arial", penwidth=1];
  edge [fontname="Arial", style=dashed, color="#707070", arrowhead=normal, arrowsize=0.8, penwidth=1.1];
  spa [label=<<table border="0" cellpadding="1" cellspacing="0"><tr><td><font point-size="13" color="#ffffff"><b>Single-Page Application</b></font></td></tr><tr><td><font point-size="8" color="#ffffff">[Container: Angular 21, TypeScript]</font></td></tr><tr><td> </td></tr><tr><td><font point-size="9.5" color="#ffffff">All clinic features in the<br/>user's web browser.</font></td></tr></table>>, shape=box, style="rounded,filled", fillcolor="#438dd5", color="#438dd5", margin="0.18,0.12"];
  subgraph cluster_api {
    label=<<font point-size="11" color="#444444"><b>API Application</b></font><br/><font point-size="8" color="#666666">[Container: ASP.NET Core, .NET 10]</font>>;
    labeljust=l; labelloc=b; style="dashed,rounded"; color="#888888"; penwidth=1.2; margin=22;
  identity [label=<<table border="0" cellpadding="1" cellspacing="0"><tr><td><font point-size="13" color="#000000"><b>Identity Controllers</b></font></td></tr><tr><td><font point-size="8" color="#000000">[Component: ASP.NET Core controllers]</font></td></tr><tr><td> </td></tr><tr><td><font point-size="9.5" color="#000000">Auth, Account and Profile:<br/>registration, login, e-mail<br/>codes, preferences.</font></td></tr></table>>, shape=box, style="rounded,filled", fillcolor="#85bbf0", color="#78a8d8", margin="0.18,0.12"];
  booking [label=<<table border="0" cellpadding="1" cellspacing="0"><tr><td><font point-size="13" color="#000000"><b>Booking Controllers</b></font></td></tr><tr><td><font point-size="8" color="#000000">[Component: ASP.NET Core controllers]</font></td></tr><tr><td> </td></tr><tr><td><font point-size="9.5" color="#000000">Appointments, StaffSchedule,<br/>TimeOff, Doctors: booking<br/>and working hours.</font></td></tr></table>>, shape=box, style="rounded,filled", fillcolor="#85bbf0", color="#78a8d8", margin="0.18,0.12"];
  clinical [label=<<table border="0" cellpadding="1" cellspacing="0"><tr><td><font point-size="13" color="#000000"><b>Clinical Controllers</b></font></td></tr><tr><td><font point-size="8" color="#000000">[Component: ASP.NET Core controllers]</font></td></tr><tr><td> </td></tr><tr><td><font point-size="9.5" color="#000000">Patients, MedicalRecords,<br/>Prescriptions, Documents.</font></td></tr></table>>, shape=box, style="rounded,filled", fillcolor="#85bbf0", color="#78a8d8", margin="0.18,0.12"];
  billing [label=<<table border="0" cellpadding="1" cellspacing="0"><tr><td><font point-size="13" color="#000000"><b>Billing &amp; Pharmacy<br/>Controllers</b></font></td></tr><tr><td><font point-size="8" color="#000000">[Component: ASP.NET Core controllers]</font></td></tr><tr><td> </td></tr><tr><td><font point-size="9.5" color="#000000">Invoices, Payments,<br/>Insurance and Store<br/>(pharmacy orders).</font></td></tr></table>>, shape=box, style="rounded,filled", fillcolor="#85bbf0", color="#78a8d8", margin="0.18,0.12"];
  comms [label=<<table border="0" cellpadding="1" cellspacing="0"><tr><td><font point-size="13" color="#000000"><b>Communication<br/>Controllers</b></font></td></tr><tr><td><font point-size="8" color="#000000">[Component: ASP.NET Core controllers]</font></td></tr><tr><td> </td></tr><tr><td><font point-size="9.5" color="#000000">Chat, Support, Contact and<br/>Notifications.</font></td></tr></table>>, shape=box, style="rounded,filled", fillcolor="#85bbf0", color="#78a8d8", margin="0.18,0.12"];
  adminCtl [label=<<table border="0" cellpadding="1" cellspacing="0"><tr><td><font point-size="13" color="#000000"><b>Admin &amp; Reports<br/>Controllers</b></font></td></tr><tr><td><font point-size="8" color="#000000">[Component: ASP.NET Core controllers]</font></td></tr><tr><td> </td></tr><tr><td><font point-size="9.5" color="#000000">Users, services,<br/>departments, rooms, reviews<br/>and reports.</font></td></tr></table>>, shape=box, style="rounded,filled", fillcolor="#85bbf0", color="#78a8d8", margin="0.18,0.12"];
  security [label=<<table border="0" cellpadding="1" cellspacing="0"><tr><td><font point-size="13" color="#000000"><b>Security Component</b></font></td></tr><tr><td><font point-size="8" color="#000000">[Component: JwtTokenService, UserTokenService, ClinicalAccess]</font></td></tr><tr><td> </td></tr><tr><td><font point-size="9.5" color="#000000">Issues JWT tokens and<br/>one-time codes; decides who<br/>may see which patient data.</font></td></tr></table>>, shape=box, style="rounded,filled", fillcolor="#85bbf0", color="#78a8d8", margin="0.18,0.12"];
  scheduling [label=<<table border="0" cellpadding="1" cellspacing="0"><tr><td><font point-size="13" color="#000000"><b>Scheduling Component</b></font></td></tr><tr><td><font point-size="8" color="#000000">[Component: AppointmentSlotService, PrepaidBookingService]</font></td></tr><tr><td> </td></tr><tr><td><font point-size="9.5" color="#000000">Finds free time slots and<br/>books paid visits.</font></td></tr></table>>, shape=box, style="rounded,filled", fillcolor="#85bbf0", color="#78a8d8", margin="0.18,0.12"];
  pdf [label=<<table border="0" cellpadding="1" cellspacing="0"><tr><td><font point-size="13" color="#000000"><b>Visit Summary PDF</b></font></td></tr><tr><td><font point-size="8" color="#000000">[Component: QuestPDF]</font></td></tr><tr><td> </td></tr><tr><td><font point-size="9.5" color="#000000">Builds a visit summary PDF<br/>in the patient's language.</font></td></tr></table>>, shape=box, style="rounded,filled", fillcolor="#85bbf0", color="#78a8d8", margin="0.18,0.12"];
  billingc [label=<<table border="0" cellpadding="1" cellspacing="0"><tr><td><font point-size="13" color="#000000"><b>Billing Component</b></font></td></tr><tr><td><font point-size="8" color="#000000">[Component: BillingRules, PaymentGateway]</font></td></tr><tr><td> </td></tr><tr><td><font point-size="9.5" color="#000000">Prices, insurance share,<br/>card payments and delivery<br/>fees (DeliveryRules).</font></td></tr></table>>, shape=box, style="rounded,filled", fillcolor="#85bbf0", color="#78a8d8", margin="0.18,0.12"];
  chat [label=<<table border="0" cellpadding="1" cellspacing="0"><tr><td><font point-size="13" color="#000000"><b>Chat Assistant</b></font></td></tr><tr><td><font point-size="8" color="#000000">[Component: ChatAssistantRouter]</font></td></tr><tr><td> </td></tr><tr><td><font point-size="9.5" color="#000000">Answers help chat questions<br/>with Claude or the built-in<br/>rule-based assistant.</font></td></tr></table>>, shape=box, style="rounded,filled", fillcolor="#85bbf0", color="#78a8d8", margin="0.18,0.12"];
  hub [label=<<table border="0" cellpadding="1" cellspacing="0"><tr><td><font point-size="13" color="#000000"><b>Real-time Hub</b></font></td></tr><tr><td><font point-size="8" color="#000000">[Component: SignalR hub, RealtimeNotifier]</font></td></tr><tr><td> </td></tr><tr><td><font point-size="9.5" color="#000000">Pushes support messages,<br/>typing, presence and new<br/>notifications to open<br/>browser tabs.</font></td></tr></table>>, shape=box, style="rounded,filled", fillcolor="#85bbf0", color="#78a8d8", margin="0.18,0.12"];
  notif [label=<<table border="0" cellpadding="1" cellspacing="0"><tr><td><font point-size="13" color="#000000"><b>Notification Component</b></font></td></tr><tr><td><font point-size="8" color="#000000">[Component: NotificationService, PresenceTracker]</font></td></tr><tr><td> </td></tr><tr><td><font point-size="9.5" color="#000000">In-app notifications and<br/>online / away / offline<br/>status.</font></td></tr></table>>, shape=box, style="rounded,filled", fillcolor="#85bbf0", color="#78a8d8", margin="0.18,0.12"];
  workers [label=<<table border="0" cellpadding="1" cellspacing="0"><tr><td><font point-size="13" color="#000000"><b>Background Workers</b></font></td></tr><tr><td><font point-size="8" color="#000000">[Component: Hosted services]</font></td></tr><tr><td> </td></tr><tr><td><font point-size="9.5" color="#000000">Appointment reminders and<br/>notification e-mails, every<br/>few minutes.</font></td></tr></table>>, shape=box, style="rounded,filled", fillcolor="#85bbf0", color="#78a8d8", margin="0.18,0.12"];
  emailc [label=<<table border="0" cellpadding="1" cellspacing="0"><tr><td><font point-size="13" color="#000000"><b>E-mail Component</b></font></td></tr><tr><td><font point-size="8" color="#000000">[Component: SmtpEmailSender, EmailTemplates]</font></td></tr><tr><td> </td></tr><tr><td><font point-size="9.5" color="#000000">Builds HTML e-mails in the<br/>recipient's language and<br/>sends them.</font></td></tr></table>>, shape=box, style="rounded,filled", fillcolor="#85bbf0", color="#78a8d8", margin="0.18,0.12"];
  audit [label=<<table border="0" cellpadding="1" cellspacing="0"><tr><td><font point-size="13" color="#000000"><b>Audit Component</b></font></td></tr><tr><td><font point-size="8" color="#000000">[Component: AuditService]</font></td></tr><tr><td> </td></tr><tr><td><font point-size="9.5" color="#000000">Records who viewed or<br/>changed patient data.</font></td></tr></table>>, shape=box, style="rounded,filled", fillcolor="#85bbf0", color="#78a8d8", margin="0.18,0.12"];
  i18n [label=<<table border="0" cellpadding="1" cellspacing="0"><tr><td><font point-size="13" color="#000000"><b>Localization Component</b></font></td></tr><tr><td><font point-size="8" color="#000000">[Component: ClinicText]</font></td></tr><tr><td> </td></tr><tr><td><font point-size="9.5" color="#000000">Texts for e-mails,<br/>notifications, chat and PDFs<br/>in 7 languages.</font></td></tr></table>>, shape=box, style="rounded,filled", fillcolor="#85bbf0", color="#78a8d8", margin="0.18,0.12"];
  storage [label=<<table border="0" cellpadding="1" cellspacing="0"><tr><td><font point-size="13" color="#000000"><b>File Storage Component</b></font></td></tr><tr><td><font point-size="8" color="#000000">[Component: LocalFileStorage]</font></td></tr><tr><td> </td></tr><tr><td><font point-size="9.5" color="#000000">Saves and reads uploaded<br/>files.</font></td></tr></table>>, shape=box, style="rounded,filled", fillcolor="#85bbf0", color="#78a8d8", margin="0.18,0.12"];
  data [label=<<table border="0" cellpadding="1" cellspacing="0"><tr><td><font point-size="13" color="#000000"><b>Data Access</b></font></td></tr><tr><td><font point-size="8" color="#000000">[Component: Entity Framework Core, UmbrellaDbContext]</font></td></tr><tr><td> </td></tr><tr><td><font point-size="9.5" color="#000000">Maps the domain model to<br/>PostgreSQL tables; used by<br/>all controllers and<br/>components.</font></td></tr></table>>, shape=box, style="rounded,filled", fillcolor="#85bbf0", color="#78a8d8", margin="0.18,0.12"];
    { rank=same; identity; booking; clinical; billing; comms; adminCtl; }
    { rank=same; security; scheduling; pdf; billingc; chat; notif; }
  }
  db [label=<<table border="0" cellpadding="1" cellspacing="0"><tr><td><font point-size="13" color="#ffffff"><b>Database</b></font></td></tr><tr><td><font point-size="8" color="#ffffff">[Container: PostgreSQL]</font></td></tr><tr><td> </td></tr><tr><td><font point-size="9.5" color="#ffffff">All clinic data.</font></td></tr></table>>, shape=cylinder, style="filled", fillcolor="#438dd5", color="#438dd5", margin="0.18,0.12"];
  files [label=<<table border="0" cellpadding="1" cellspacing="0"><tr><td><font point-size="13" color="#ffffff"><b>File Storage</b></font></td></tr><tr><td><font point-size="8" color="#ffffff">[Container: Docker volume]</font></td></tr><tr><td> </td></tr><tr><td><font point-size="9.5" color="#ffffff">Uploaded files.</font></td></tr></table>>, shape=cylinder, style="filled", fillcolor="#438dd5", color="#438dd5", margin="0.18,0.12"];
  email [label=<<table border="0" cellpadding="1" cellspacing="0"><tr><td><font point-size="13" color="#ffffff"><b>E-mail System</b></font></td></tr><tr><td><font point-size="8" color="#ffffff">[Software System]</font></td></tr><tr><td> </td></tr><tr><td><font point-size="9.5" color="#ffffff">SMTP mail server (Gmail)<br/>that delivers codes,<br/>reminders and notifications.</font></td></tr></table>>, shape=box, style="rounded,filled", fillcolor="#999999", color="#999999", margin="0.18,0.12"];
  claude [label=<<table border="0" cellpadding="1" cellspacing="0"><tr><td><font point-size="13" color="#ffffff"><b>Anthropic Claude API</b></font></td></tr><tr><td><font point-size="8" color="#ffffff">[Software System]</font></td></tr><tr><td> </td></tr><tr><td><font point-size="9.5" color="#ffffff">Optional AI model for the<br/>help chat. A built-in<br/>assistant answers when it is<br/>not configured.</font></td></tr></table>>, shape=box, style="rounded,filled", fillcolor="#999999", color="#999999", margin="0.18,0.12"];
  { rank=same; db; files; email; claude; }
