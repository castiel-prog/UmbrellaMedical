digraph G {
  graph [fontname="Arial", rankdir=TB, nodesep=0.55, ranksep=0.85, pad=0.3, newrank=true, nodesep=0.7];
  node [fontname="Arial", penwidth=1];
  edge [fontname="Arial", style=dashed, color="#707070", arrowhead=normal, arrowsize=0.8, penwidth=1.1];
  patient [label=<<table border="0" cellpadding="1" cellspacing="0"><tr><td> </td></tr><tr><td><font point-size="13" color="#ffffff"><b>Patient</b></font></td></tr><tr><td><font point-size="8" color="#ffffff">[Person]</font></td></tr><tr><td> </td></tr><tr><td><font point-size="9.5" color="#ffffff">A person who books visits,<br/>sees their health records and<br/>orders medicines online.</font></td></tr></table>>, shape=box, style="rounded,filled", fillcolor="#08427b", color="#08427b", margin="0.18,0.12", width=2.4];
  doctor [label=<<table border="0" cellpadding="1" cellspacing="0"><tr><td> </td></tr><tr><td><font point-size="13" color="#ffffff"><b>Doctor</b></font></td></tr><tr><td><font point-size="8" color="#ffffff">[Person]</font></td></tr><tr><td> </td></tr><tr><td><font point-size="9.5" color="#ffffff">Sees patients, writes medical<br/>records and prescriptions.</font></td></tr></table>>, shape=box, style="rounded,filled", fillcolor="#08427b", color="#08427b", margin="0.18,0.12", width=2.4];
  receptionist [label=<<table border="0" cellpadding="1" cellspacing="0"><tr><td> </td></tr><tr><td><font point-size="13" color="#ffffff"><b>Receptionist</b></font></td></tr><tr><td><font point-size="8" color="#ffffff">[Person]</font></td></tr><tr><td> </td></tr><tr><td><font point-size="9.5" color="#ffffff">Registers patients, manages<br/>bookings, invoices and<br/>pharmacy orders.</font></td></tr></table>>, shape=box, style="rounded,filled", fillcolor="#08427b", color="#08427b", margin="0.18,0.12", width=2.4];
  admin [label=<<table border="0" cellpadding="1" cellspacing="0"><tr><td> </td></tr><tr><td><font point-size="13" color="#ffffff"><b>Administrator</b></font></td></tr><tr><td><font point-size="8" color="#ffffff">[Person]</font></td></tr><tr><td> </td></tr><tr><td><font point-size="9.5" color="#ffffff">Manages staff, services and<br/>prices, reads reports and<br/>answers support chats.</font></td></tr></table>>, shape=box, style="rounded,filled", fillcolor="#08427b", color="#08427b", margin="0.18,0.12", width=2.4];
  umbrella [label=<<table border="0" cellpadding="1" cellspacing="0"><tr><td><font point-size="13" color="#ffffff"><b>Umbrella Medical Center</b></font></td></tr><tr><td><font point-size="8" color="#ffffff">[Software System]</font></td></tr><tr><td> </td></tr><tr><td><font point-size="9.5" color="#ffffff">Lets patients book and pay for<br/>visits, see their medical records<br/>and order medicines, and lets the<br/>clinic staff run the clinic.</font></td></tr></table>>, shape=box, style="rounded,filled", fillcolor="#1168bd", color="#1168bd", margin="0.18,0.12"];
  email [label=<<table border="0" cellpadding="1" cellspacing="0"><tr><td><font point-size="13" color="#ffffff"><b>E-mail System</b></font></td></tr><tr><td><font point-size="8" color="#ffffff">[Software System]</font></td></tr><tr><td> </td></tr><tr><td><font point-size="9.5" color="#ffffff">SMTP mail server (Gmail)<br/>that delivers codes,<br/>reminders and notifications.</font></td></tr></table>>, shape=box, style="rounded,filled", fillcolor="#999999", color="#999999", margin="0.18,0.12"];
  claude [label=<<table border="0" cellpadding="1" cellspacing="0"><tr><td><font point-size="13" color="#ffffff"><b>Anthropic Claude API</b></font></td></tr><tr><td><font point-size="8" color="#ffffff">[Software System]</font></td></tr><tr><td> </td></tr><tr><td><font point-size="9.5" color="#ffffff">Optional AI model for the<br/>help chat. A built-in<br/>assistant answers when it is<br/>not configured.</font></td></tr></table>>, shape=box, style="rounded,filled", fillcolor="#999999", color="#999999", margin="0.18,0.12"];
  { rank=same; patient; doctor; receptionist; admin; }
  { rank=same; umbrella; email; }
  patient -> umbrella [label=<<font point-size="9" color="#444444">Books visits, sees<br/>records, orders medicines<br/>and chats with support<br/>using</font>>];
  doctor -> umbrella [label=<<font point-size="9" color="#444444">Manages schedule, records<br/>and prescriptions using</font>>];
  receptionist -> umbrella [label=<<font point-size="9" color="#444444">Registers patients, books<br/>visits and takes payments<br/>using</font>>];
  admin -> umbrella [label=<<font point-size="9" color="#444444">Runs the clinic and<br/>answers support chats<br/>using</font>>];
  umbrella -> email [label=<<font point-size="9" color="#444444">Sends e-mails using</font>>];
  email -> patient [label=<<font point-size="9" color="#444444">Sends e-mails to</font>>, constraint=false];
  umbrella -> claude [label=<<font point-size="9" color="#444444">Gets help chat answers<br/>from</font>>];
}