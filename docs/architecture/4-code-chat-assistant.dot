digraph G {
  graph [fontname="Arial", rankdir=TB, nodesep=0.55, ranksep=0.85, pad=0.3, newrank=true, ranksep=0.7, nodesep=0.5];
  node [fontname="Arial", penwidth=1];
  edge [fontname="Arial", style=dashed, color="#707070", arrowhead=normal, arrowsize=0.8, penwidth=1.1];
  subgraph cluster_ns { label=<<font point-size="10"><b>UmbrellaMedical.Api.Services  (Chat Assistant component)</b></font>>; labeljust=l; labelloc=t; style=solid; color="#555555"; margin=18;
  ichat [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#ffffff" color="#333333"><tr><td bgcolor="#e8f0fb"><font point-size="8">«interface»</font><br/><font point-size="11"><b><i>IChatAssistant</i></b></font></td></tr><tr><td align="left" balign="left"> </td></tr><tr><td align="left" balign="left"><font point-size="9">+ IsConfigured : bool</font><br/><font point-size="9">+ Mode : string</font><br/><font point-size="9">+ ReplyAsync(conversation, lang, ct) : Task&lt;ChatAnswer&gt;</font></td></tr></table>>];
  router [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#ffffff" color="#333333"><tr><td bgcolor="#e8f0fb"><font point-size="11"><b>ChatAssistantRouter</b></font></td></tr><tr><td align="left" balign="left"><font point-size="9">- _ai : ClaudeChatAssistant</font><br/><font point-size="9">- _rules : RuleBasedChatAssistant</font><br/><font point-size="9">- _logger : ILogger</font></td></tr><tr><td align="left" balign="left"><font point-size="9">+ ReplyAsync(conversation, lang, ct) : Task&lt;ChatAnswer&gt;</font></td></tr></table>>];
  claudeA [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#ffffff" color="#333333"><tr><td bgcolor="#e8f0fb"><font point-size="11"><b>ClaudeChatAssistant</b></font></td></tr><tr><td align="left" balign="left"><font point-size="9">- _client : AnthropicClient?</font><br/><font point-size="9">- _directory : IClinicDirectory</font></td></tr><tr><td align="left" balign="left"><font point-size="9">+ ReplyAsync(conversation, lang, ct) : Task&lt;ChatAnswer&gt;</font></td></tr></table>>];
  rules [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#ffffff" color="#333333"><tr><td bgcolor="#e8f0fb"><font point-size="11"><b>RuleBasedChatAssistant</b></font></td></tr><tr><td align="left" balign="left"><font point-size="9">- _directory : IClinicDirectory</font><br/><font point-size="9">- _text : IClinicText</font></td></tr><tr><td align="left" balign="left"><font point-size="9">+ ReplyAsync(conversation, lang, ct) : Task&lt;ChatAnswer&gt;</font></td></tr></table>>];
  idir [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#ffffff" color="#333333"><tr><td bgcolor="#e8f0fb"><font point-size="8">«interface»</font><br/><font point-size="11"><b><i>IClinicDirectory</i></b></font></td></tr><tr><td align="left" balign="left"> </td></tr><tr><td align="left" balign="left"><font point-size="9">+ GetAsync(ct) : Task&lt;ClinicSnapshot&gt;</font></td></tr></table>>];
  dir [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#ffffff" color="#333333"><tr><td bgcolor="#e8f0fb"><font point-size="11"><b>ClinicDirectory</b></font></td></tr><tr><td align="left" balign="left"><font point-size="9">- _scopes : IServiceScopeFactory</font><br/><font point-size="9">- _cache : IMemoryCache</font></td></tr><tr><td align="left" balign="left"><font point-size="9">+ GetAsync(ct) : Task&lt;ClinicSnapshot&gt;</font><br/><font point-size="9">+ DescribeHours(hours, culture) : string</font></td></tr></table>>];
  itext [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#ffffff" color="#333333"><tr><td bgcolor="#e8f0fb"><font point-size="8">«interface»</font><br/><font point-size="11"><b><i>IClinicText</i></b></font></td></tr><tr><td align="left" balign="left"> </td></tr><tr><td align="left" balign="left"><font point-size="9">+ T(text, lang, args) : string</font><br/><font point-size="9">+ Normalize(lang) : string</font></td></tr></table>>];
  turn [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#ffffff" color="#333333"><tr><td bgcolor="#e8f0fb"><font point-size="8">«record»</font><br/><font point-size="11"><b>ChatTurn</b></font></td></tr><tr><td align="left" balign="left"><font point-size="9">+ Role : string</font><br/><font point-size="9">+ Content : string</font></td></tr><tr><td align="left" balign="left"> </td></tr></table>>];
  answer [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#ffffff" color="#333333"><tr><td bgcolor="#e8f0fb"><font point-size="8">«record»</font><br/><font point-size="11"><b>ChatAnswer</b></font></td></tr><tr><td align="left" balign="left"><font point-size="9">+ Text : string</font><br/><font point-size="9">+ Suggestions : IReadOnlyList&lt;string&gt;</font></td></tr><tr><td align="left" balign="left"> </td></tr></table>>];
  snapshot [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#ffffff" color="#333333"><tr><td bgcolor="#e8f0fb"><font point-size="8">«record»</font><br/><font point-size="11"><b>ClinicSnapshot</b></font></td></tr><tr><td align="left" balign="left"><font point-size="9">+ Doctors, Services, Specializations</font><br/><font point-size="9">+ Hours, Address, Phone</font></td></tr><tr><td align="left" balign="left"> </td></tr></table>>];
  }
  controller [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" bgcolor="#ffffff" color="#333333"><tr><td bgcolor="#e8f0fb"><font point-size="11"><b>ChatController</b></font></td></tr><tr><td align="left" balign="left"><font point-size="9">- _assistant : IChatAssistant</font></td></tr><tr><td align="left" balign="left"><font point-size="9">+ Status() : ActionResult</font><br/><font point-size="9">+ Post(ChatRequest, ct) : ActionResult&lt;ChatReplyDto&gt;</font></td></tr></table>>];
  controller -> ichat [style=dashed, arrowhead=vee, color="#555555", label=<<font point-size="9" color="#333333">uses</font>>];
  router -> ichat [style=dashed, arrowhead=onormal, arrowsize=1.1, color="#333333"];
  claudeA -> ichat [style=dashed, arrowhead=onormal, arrowsize=1.1, color="#333333"];
  rules -> ichat [style=dashed, arrowhead=onormal, arrowsize=1.1, color="#333333"];
  router -> claudeA [style=dashed, arrowhead=vee, color="#555555", label=<<font point-size="9" color="#333333">tries first</font>>];
  router -> rules [style=dashed, arrowhead=vee, color="#555555", label=<<font point-size="9" color="#333333">falls back to</font>>];
  claudeA -> idir [style=dashed, arrowhead=vee, color="#555555", label=<<font point-size="9" color="#333333">reads clinic data</font>>];
  rules -> idir [style=dashed, arrowhead=vee, color="#555555", label=<<font point-size="9" color="#333333">reads clinic data</font>>];
  rules -> itext [style=dashed, arrowhead=vee, color="#555555", label=<<font point-size="9" color="#333333">translates with</font>>];
  dir -> idir [style=dashed, arrowhead=onormal, arrowsize=1.1, color="#333333"];
  idir -> snapshot [style=dashed, arrowhead=vee, color="#555555", label=<<font point-size="9" color="#333333">returns</font>>];
  ichat -> turn [style=dashed, arrowhead=vee, color="#555555", label=<<font point-size="9" color="#333333">reads</font>>];
  ichat -> answer [style=dashed, arrowhead=vee, color="#555555", label=<<font point-size="9" color="#333333">returns</font>>];
  { rank=same; router; turn; answer; }
}