digraph G {
  graph [fontname="Arial", rankdir=TB, nodesep=0.55, ranksep=0.85, pad=0.3, newrank=true, ];
  node [fontname="Arial", penwidth=1];
  edge [fontname="Arial", style=dashed, color="#707070", arrowhead=normal, arrowsize=0.8, penwidth=1.1];
  patient [label=<<table border="0" cellpadding="1" cellspacing="0"><tr><td> </td></tr><tr><td><font point-size="13" color="#ffffff"><b>Patient</b></font></td></tr><tr><td><font point-size="8" color="#ffffff">[Person]</font></td></tr><tr><td> </td></tr><tr><td><font point-size="9.5" color="#ffffff">A person who books visits,<br/>sees their health records and<br/>orders medicines online.</font></td></tr></table>>, shape=box, style="rounded,filled", fillcolor="#08427b", color="#08427b", margin="0.18,0.12", width=2.4];
  staff [label=<<table border="0" cellpadding="1" cellspacing="0"><tr><td> </td></tr><tr><td><font point-size="13" color="#ffffff"><b>Clinic Staff</b></font></td></tr><tr><td><font point-size="8" color="#ffffff">[Person]</font></td></tr><tr><td> </td></tr><tr><td><font point-size="9.5" color="#ffffff">Doctors, receptionists and<br/>administrators.</font></td></tr></table>>, shape=box, style="rounded,filled", fillcolor="#08427b", color="#08427b", margin="0.18,0.12", width=2.4];
  subgraph cluster_umbrella {
    label=<<font point-size="11" color="#444444"><b>Umbrella Medical Center</b></font><br/><font point-size="8" color="#666666">[Software System]</font>>;
    labeljust=l; labelloc=b; style="dashed,rounded"; color="#888888"; penwidth=1.2; margin=22;
  web [label=<<table border="0" cellpadding="1" cellspacing="0"><tr><td><font point-size="13" color="#ffffff"><b>Web Server</b></font></td></tr><tr><td><font point-size="8" color="#ffffff">[Container: Caddy 2, Docker]</font></td></tr><tr><td> </td></tr><tr><td><font point-size="9.5" color="#ffffff">Serves the Angular app, gives<br/>HTTPS (Let's Encrypt) and<br/>forwards /api requests to the<br/>API.</font></td></tr></table>>, shape=box, style="rounded,filled", fillcolor="#438dd5", color="#438dd5", margin="0.18,0.12"];
  spa [label=<<table border="0" cellpadding="1" cellspacing="0"><tr><td><font point-size="13" color="#ffffff"><b>Single-Page Application</b></font></td></tr><tr><td><font point-size="8" color="#ffffff">[Container: Angular 21, TypeScript]</font></td></tr><tr><td> </td></tr><tr><td><font point-size="9.5" color="#ffffff">All clinic features in the<br/>browser: booking, records,<br/>pharmacy, support chat and<br/>admin pages, in 7 languages.</font></td></tr></table>>, shape=box, style="rounded,filled", fillcolor="#438dd5", color="#438dd5", margin="0.18,0.12"];
  api [label=<<table border="0" cellpadding="1" cellspacing="0"><tr><td><font point-size="13" color="#ffffff"><b>API Application</b></font></td></tr><tr><td><font point-size="8" color="#ffffff">[Container: ASP.NET Core, .NET 10, Docker]</font></td></tr><tr><td> </td></tr><tr><td><font point-size="9.5" color="#ffffff">Business logic as a JSON/HTTPS<br/>REST API with JWT login, a SignalR<br/>hub for real-time updates, Swagger<br/>docs and background jobs for<br/>reminders and e-mails.</font></td></tr></table>>, shape=box, style="rounded,filled", fillcolor="#438dd5", color="#438dd5", margin="0.18,0.12"];
  db [label=<<table border="0" cellpadding="1" cellspacing="0"><tr><td><font point-size="13" color="#ffffff"><b>Database</b></font></td></tr><tr><td><font point-size="8" color="#ffffff">[Container: PostgreSQL, DigitalOcean Managed DB]</font></td></tr><tr><td> </td></tr><tr><td><font point-size="9.5" color="#ffffff">Users, patients, appointments,<br/>medical records, invoices,<br/>orders and chats.</font></td></tr></table>>, shape=cylinder, style="filled", fillcolor="#438dd5", color="#438dd5", margin="0.18,0.12"];
  files [label=<<table border="0" cellpadding="1" cellspacing="0"><tr><td><font point-size="13" color="#ffffff"><b>File Storage</b></font></td></tr><tr><td><font point-size="8" color="#ffffff">[Container: Docker volume]</font></td></tr><tr><td> </td></tr><tr><td><font point-size="9.5" color="#ffffff">Uploaded documents, photos<br/>and certificates.</font></td></tr></table>>, shape=cylinder, style="filled", fillcolor="#438dd5", color="#438dd5", margin="0.18,0.12"];
    { rank=same; web; spa; }
    { rank=same; db; files; }
  }
  email [label=<<table border="0" cellpadding="1" cellspacing="0"><tr><td><font point-size="13" color="#ffffff"><b>E-mail System</b></font></td></tr><tr><td><font point-size="8" color="#ffffff">[Software System]</font></td></tr><tr><td> </td></tr><tr><td><font point-size="9.5" color="#ffffff">SMTP mail server (Gmail)<br/>that delivers codes,<br/>reminders and notifications.</font></td></tr></table>>, shape=box, style="rounded,filled", fillcolor="#999999", color="#999999", margin="0.18,0.12"];
  claude [label=<<table border="0" cellpadding="1" cellspacing="0"><tr><td><font point-size="13" color="#ffffff"><b>Anthropic Claude API</b></font></td></tr><tr><td><font point-size="8" color="#ffffff">[Software System]</font></td></tr><tr><td> </td></tr><tr><td><font point-size="9.5" color="#ffffff">Optional AI model for the<br/>help chat. A built-in<br/>assistant answers when it is<br/>not configured.</font></td></tr></table>>, shape=box, style="rounded,filled", fillcolor="#999999", color="#999999", margin="0.18,0.12"];
  { rank=same; patient; staff; }
  patient -> web [label=<<font point-size="9" color="#444444">Visits umbrellaclinic.xyz<br/>using</font><br/><font point-size="7.5" color="#666666">[HTTPS]</font>>];
  web -> spa [label=<<font point-size="9" color="#444444">Delivers the app to the<br/>user's web browser</font>>];
  patient -> spa [label=<<font point-size="9" color="#444444">Books visits, sees records<br/>and orders medicines using</font>>];
  staff -> spa [label=<<font point-size="9" color="#444444">Runs the clinic using</font>>];
  spa -> api [label=<<font point-size="9" color="#444444">Makes API calls to</font><br/><font point-size="7.5" color="#666666">[JSON/HTTPS, through the web server]</font>>];
  api -> spa [label=<<font point-size="9" color="#444444">Pushes chat messages,<br/>presence and notifications<br/>to</font><br/><font point-size="7.5" color="#666666">[SignalR, WebSocket]</font>>, constraint=false];
  web -> api [label=<<font point-size="9" color="#444444">Forwards /api requests to</font><br/><font point-size="7.5" color="#666666">[HTTP, internal Docker network]</font>>];
  api -> db [label=<<font point-size="9" color="#444444">Reads from and writes to</font><br/><font point-size="7.5" color="#666666">[EF Core, SQL over TLS]</font>>];
  api -> files [label=<<font point-size="9" color="#444444">Reads and writes files in</font><br/><font point-size="7.5" color="#666666">[File system]</font>>];
  api -> email [label=<<font point-size="9" color="#444444">Sends e-mails using</font><br/><font point-size="7.5" color="#666666">[SMTP]</font>>];
  api -> claude [label=<<font point-size="9" color="#444444">Gets AI chat answers from</font><br/><font point-size="7.5" color="#666666">[HTTPS]</font>>];
  email -> patient [label=<<font point-size="9" color="#444444">Sends e-mails to</font>>, constraint=false];
}