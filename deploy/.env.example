# Copy to .env (same folder) on the server and fill in. Never commit the real .env.

# Your domain (its DNS A record must point at the droplet), or <ip-with-dashes>.sslip.io for free HTTPS
# without a domain, e.g. 134-209-26-191.sslip.io.  ":80" = plain HTTP on the IP (Chrome may refuse it).
SITE_ADDRESS=:80

# DigitalOcean Managed PostgreSQL, in Npgsql format. From the database's "Connection details"
# (use the VPC / private host on the droplet). The "umbrella" database is created automatically.
DB_CONNECTION=Host=private-xxxx.db.ondigitalocean.com;Port=25060;Database=umbrella;Username=doadmin;Password=xxxx;SSL Mode=Require;Maximum Pool Size=8

# Token signing key, 32+ random chars:  openssl rand -hex 40
JWT_KEY=
# Password of the admin account (admin@umbrella.local), 8+ chars.
ADMIN_PASSWORD=

# Showcase data. DEMO_STAFF_PASSWORD creates the demo doctors and receptionists with that password;
# DEMO_PATIENTS=true adds the demo patients (password Patient123) and their reviews.
# Anyone who knows these passwords can log in as staff and see patient data, so turn them off
# (empty / false) before real patients use the site.
DEMO_STAFF_PASSWORD=
DEMO_PATIENTS=true

# Email (verification codes, reminders, notices). Gmail needs an App Password.
# DigitalOcean blocks outgoing SMTP on new accounts: ask support to unblock it, or use a
# provider that listens on port 2525 (Brevo, Mailgun, SendGrid...).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=

# Optional: Claude answers in the help chat. Empty = the built-in FAQ bot.
ANTHROPIC_API_KEY=

# Where contact-form messages are sent (the clinic's own inbox).
CLINIC_CONTACT_EMAIL=
